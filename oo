<script>

let midiData = null;

let audioCtx = null;

let activeNodes = [];

let isPlaying = false;

let playTimeouts = [];

let animInterval = null;



function initAudio() {

if (!audioCtx) {

audioCtx = new (window.AudioContext || window.webkitAudioContext)();

}

}



function handleFile(files) {

if (!files.length) return;

const file = files[0];



const reader = new FileReader();

reader.onload = function(e) {

midiData = new Midi(e.target.result);



// MIDIヘッダーの曲名を取得、なければ最初のトラック名、それも無ければファイル名から取得

let title = midiData.name;

if (!title && midiData.tracks.length > 0) {

title = midiData.tracks[0].name;

}

if (!title || title.trim() === '') {

title = file.name.replace(/\.[^/.]+$/, ""); // 拡張子を除去

}



document.getElementById('songTitle').innerText = title;



document.getElementById('playBtn').disabled = false;

document.getElementById('playBtn').style.background = '#10B981';

document.getElementById('playBtn').style.color = '#000';

};

reader.readAsArrayBuffer(file);

}



function playMidi() {

if (!midiData || isPlaying) return;

initAudio();

if (audioCtx.state === 'suspended') audioCtx.resume();



stopMidi();

isPlaying = true;



document.getElementById('stopBtn').disabled = false;

document.getElementById('stopBtn').style.background = '#EF4444';

document.getElementById('stopBtn').style.color = '#FFF';



startVisualizer();



const now = audioCtx.currentTime;



midiData.tracks.forEach(track => {

track.notes.forEach(note => {

const startTime = now + note.time;

const duration = note.duration;



const timeoutId = setTimeout(() => {

if (!isPlaying) return;



if (track.channel === 9) {

playNoise(note.duration);

} else {

playSquareWave(note.midi, note.duration, note.velocity);

}

}, note.time * 1000);



playTimeouts.push(timeoutId);

});

});

}



function playSquareWave(midiNote, duration, velocity) {

if (!isPlaying) return;



const osc = audioCtx.createOscillator();

const gain = audioCtx.createGain();



const freq = 440 * Math.pow(2, (midiNote - 69) / 12);



osc.type = 'square';

osc.frequency.value = freq;



const vol = (velocity || 0.7) * 0.15;

gain.gain.setValueAtTime(vol, audioCtx.currentTime);

gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + Math.min(duration, 0.4));



osc.connect(gain);

gain.connect(audioCtx.destination);



osc.start();

osc.stop(audioCtx.currentTime + Math.min(duration, 0.4));



activeNodes.push(osc);

}



function playNoise(duration) {

if (!isPlaying) return;



const bufferSize = audioCtx.sampleRate * 0.05;

const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);

const data = buffer.getChannelData(0);

for (let i = 0; i < bufferSize; i++) {

data[i] = Math.random() * 2 - 1;

}



const noise = audioCtx.createBufferSource();

noise.buffer = buffer;



const gain = audioCtx.createGain();

gain.gain.setValueAtTime(0.1, audioCtx.currentTime);

gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);



noise.connect(gain);

gain.connect(audioCtx.destination);



noise.start();

}



function stopMidi() {

isPlaying = false;

playTimeouts.forEach(t => clearTimeout(t));

playTimeouts = [];



activeNodes.forEach(node => {

try { node.stop(); } catch(e) {}

});

activeNodes = [];



document.getElementById('stopBtn').disabled = true;

document.getElementById('stopBtn').style.background = '#374151';

document.getElementById('stopBtn').style.color = '#9CA3AF';



stopVisualizer();

}



function startVisualizer() {

const bars = document.querySelectorAll('.bar');

animInterval = setInterval(() => {

bars.forEach(bar => {

const h = Math.floor(Math.random() * 80) + 10;

bar.style.height = h + '%';

});

}, 100);

}



function stopVisualizer() {

clearInterval(animInterval);

const bars = document.querySelectorAll('.bar');

bars.forEach(bar => bar.style.height = '10%');

}

</script>

